# Add these to the repository root .env or export them in your shell.
# 将这些变量加入仓库根目录的 .env，或导出到环境变量中。
GROQ_API_KEY=your-groq-api-key
# Everything below is optional.
# 以下配置均为可选项。
AGENT_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com
GROQ_TEMPERATURE=0.2
AGENT_MAX_ITERATIONS=8
AGENT_MAX_REFLECTIONS=1
AGENT_REFLECTION=true
AGENT_CONTEXT_BUDGET=6000
AGENT_TOOL_TIMEOUT_SECONDS=20
# Mutating expense tools pause for human approval.
# 修改账本的工具会暂停，等待人工审批。
AGENT_RISKY_TOOLS=add_expense,update_expense,delete_expense
# Optional: choose a separate persistent data directory.
# 可选：指定独立的持久化目录。
# AGENT_DATA_DIR=/path/to/ledger-data
